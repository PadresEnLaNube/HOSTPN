msgid ""
"The stay is agreed from <strong>[hostpn-contract-start-date]</strong> until "
"<strong>[hostpn-contract-end-date]</strong>."
msgstr ""
"La estancia se acuerda desde el <strong>[hostpn-contract-start-date]</strong>"
" hasta el <strong>[hostpn-contract-end-date]</strong>."

